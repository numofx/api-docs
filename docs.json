{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Numo Docs",
  "colors": {
    "primary": "#4EA7E5",
    "light": "#7BC4F2",
    "dark": "#2F86C9"
  },
  "favicon": "/images/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "spot",
              "futures",
              "signing",
              "errors",
              "development",
              "ai-tools/mcp"
            ]
          },
          {
            "group": "Core services",
            "pages": [
              "essentials/settings",
              "essentials/navigation"
            ]
          },
          {
            "group": "Changelog",
            "pages": [
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "API",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Markets service",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/book",
              "api-reference/endpoint/trades",
              "api-reference/endpoint/candles",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/order-status",
              "api-reference/endpoint/order-history",
              "api-reference/endpoint/fills",
              "api-reference/endpoint/positions",
              "api-reference/endpoint/withdrawals",
              "api-reference/endpoint/deposits",
              "api-reference/websocket"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "api-reference/endpoint/integrations-tickers",
              "api-reference/endpoint/integrations-orderbook",
              "api-reference/endpoint/integrations-trades"
            ]
          },
          {
            "group": "Execution service",
            "pages": [
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "API",
          "href": "/api-reference/introduction",
          "icon": "terminal"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://app.numofx.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/numofx/api-docs"
    }
  }
}
